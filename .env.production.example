# =============================================================================
# Talk-to-a-Folder - Production Environment (.env.production)
# =============================================================================
# Copy this file to .env.production and fill in real values:
#   cp .env.production.example .env.production
#
# Used by:
#   production-db.ps1  — runs Alembic migrations against Supabase
#   deploy.ps1         — (reads .env.deploy for ACR creds, not this file)
#   Azure App Service  — set these same values in Configuration > App Settings
# =============================================================================

# Supabase PostgreSQL (use Session Pooler URL for IPv4 compatibility with Azure)
# Format: postgresql+asyncpg://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql+asyncpg://postgres.xxxxx:your-db-password@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Google OAuth (same client, but redirect URI must point to production)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=https://your-app.azurewebsites.net/auth/google/callback

# Azure AI Search
AZURE_SEARCH_ENDPOINT=https://your-search.search.windows.net
AZURE_SEARCH_API_KEY=your-key
AZURE_SEARCH_INDEX_NAME=talk-to-folder-chunks

# OpenAI (embeddings)
OPENAI_API_KEY=sk-your-key

# Anthropic (LLM)
ANTHROPIC_API_KEY=sk-ant-your-key

# Security (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=your-fernet-key

# Frontend URL (must match Azure App Service domain)
FRONTEND_URL=https://your-app.azurewebsites.net
