# =============================================================================
# Talk-to-a-Folder - Environment Variables
# =============================================================================
# Copy this file to .env and fill in real values:
#   cp .env.example .env
# =============================================================================

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/talk_to_folder

# Google OAuth
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# OpenAI
OPENAI_API_KEY=sk-your-key

# Anthropic (optional — currently unused, reserved for future re-enablement)
# ANTHROPIC_API_KEY=sk-ant-your-key

# Security
ENCRYPTION_KEY=your-fernet-key

# Frontend URL (used for OAuth redirect and cookie security)
FRONTEND_URL=http://localhost:5173

# Azure Blob Storage (optional)
AZURE_STORAGE_CONNECTION_STRING=

# LLM Model names (defaults are fine for dev)
# AGENT_MODEL=gpt-5.2

# Resource limits
# MAX_MESSAGE_LENGTH=32000
# MAX_CHAT_HISTORY_MESSAGES=100
# MAX_SPREADSHEET_SEARCH_ROWS=10000
# MAX_FILE_DOWNLOAD_BYTES=104857600
# MAX_SPREADSHEET_BYTES=52428800

# Sync guardrails
# MAX_SYNC_FILES=5000
# MAX_FOLDER_DEPTH=10

# Timeouts (seconds)
# DRIVE_API_TIMEOUT=30.0
# DRIVE_DOWNLOAD_TIMEOUT=60.0

# CORS (comma-separated)
# CORS_ALLOWED_METHODS=GET,POST,DELETE,OPTIONS
# CORS_ALLOWED_HEADERS=Content-Type,X-Requested-With

# =============================================================================
# Production Deployment
# =============================================================================
# For Azure deployment, create a `.env.production` file (git-ignored) with:
#   DATABASE_URL          — Supabase PostgreSQL connection string (Session Pooler, IPv4)
#   GOOGLE_CLIENT_ID      — same as dev, but GOOGLE_REDIRECT_URI must point to prod
#   GOOGLE_CLIENT_SECRET
#   GOOGLE_REDIRECT_URI   — https://your-app.azurewebsites.net/auth/google/callback
#   OPENAI_API_KEY
#   ENCRYPTION_KEY
#   FRONTEND_URL          — https://your-app.azurewebsites.net
#
# deploy.ps1        — builds Docker image and pushes to ACR
