# =============================================================================
# Talk-to-a-Folder - Environment Variables
# =============================================================================
# Copy this file to .env and fill in real values:
#   cp .env.example .env
# =============================================================================

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/talk_to_folder

# Google OAuth
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Azure AI Search
AZURE_SEARCH_ENDPOINT=https://your-search.search.windows.net
AZURE_SEARCH_API_KEY=your-key
AZURE_SEARCH_INDEX_NAME=talk-to-folder-chunks

# OpenAI
OPENAI_API_KEY=sk-your-key

# Anthropic (optional — currently unused, reserved for future re-enablement)
# ANTHROPIC_API_KEY=sk-ant-your-key

# Temporal
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default

# Security
ENCRYPTION_KEY=your-fernet-key

# Frontend URL (used for OAuth redirect and cookie security)
FRONTEND_URL=http://localhost:5173

# Azure Blob Storage (optional)
AZURE_STORAGE_CONNECTION_STRING=

# =============================================================================
# Production Deployment
# =============================================================================
# For Azure deployment, create a `.env.production` file (git-ignored) with:
#   DATABASE_URL          — Supabase PostgreSQL connection string (Session Pooler, IPv4)
#   GOOGLE_CLIENT_ID      — same as dev, but GOOGLE_REDIRECT_URI must point to prod
#   GOOGLE_CLIENT_SECRET
#   GOOGLE_REDIRECT_URI   — https://your-app.azurewebsites.net/auth/google/callback
#   AZURE_SEARCH_ENDPOINT
#   AZURE_SEARCH_API_KEY
#   AZURE_SEARCH_INDEX_NAME
#   OPENAI_API_KEY
#   ANTHROPIC_API_KEY
#   ENCRYPTION_KEY
#   FRONTEND_URL          — https://your-app.azurewebsites.net
#
# deploy.ps1        — builds Docker image and pushes to ACR
# production-db.ps1 — runs Alembic migrations against the production database
